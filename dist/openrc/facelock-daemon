#!/sbin/openrc-run
# OpenRC init script for facelock face authentication daemon
#
# The paths and modes below MUST match dist/facelock.tmpfiles, which is the
# reference for every other packaging fragment. OpenRC has no post-install
# hook, so this is also the only place the repo controls that can carry an
# OpenRC install across a layout change.

description="Facelock Face Authentication Daemon"
command="/usr/bin/facelock"
command_args="daemon"
command_background=true
pidfile="/run/facelock/daemon.pid"

depend() {
    need localmount dbus
    after bootmisc
}

start_pre() {
    # Nothing is group-owned any more (ADR 010).
    checkpath --directory --owner root:root --mode 0755 /run/facelock

    # checkpath does not create parents, so the state dir comes first.
    # 0711 root:root: traversable by everyone, listable by root only (ADR 010).
    checkpath --directory --owner root:root --mode 0711 /var/lib/facelock
    # Models are public, SHA256-verified downloads.
    checkpath --directory --owner root:root --mode 0755 /var/lib/facelock/models
    # `facelock is-enrolled` markers: traversable by all, listable by none.
    checkpath --directory --owner root:root --mode 0711 /var/lib/facelock/enrolled
    # PAM rollback state contains complete service files: root-only.
    checkpath --directory --owner root:root --mode 0700 /var/lib/facelock/pam-backups

    # Database and sidecars hold encrypted biometric templates: root-only.
    # Tighten if present, never create.
    for f in /var/lib/facelock/facelock.db /var/lib/facelock/facelock.db-wal /var/lib/facelock/facelock.db-shm; do
        if [ -f "$f" ]; then
            chown root:root "$f"
            chmod 0600 "$f"
        fi
    done

    # Audit log (per-user auth history) and snapshots (raw face images):
    # root-only.
    checkpath --directory --owner root:root --mode 0700 /var/log/facelock
    checkpath --directory --owner root:root --mode 0700 /var/log/facelock/snapshots
    if [ -f /var/log/facelock/audit.jsonl ]; then
        chown root:root /var/log/facelock/audit.jsonl
        chmod 0600 /var/log/facelock/audit.jsonl
    fi
}
